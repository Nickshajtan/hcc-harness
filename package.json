{
  "name": "arch-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "arch": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "npm run build && vitest run tests/acceptance",
    "test:wizard": "npm run build && vitest run tests/unit/wizard.test.ts tests/unit/discovery.test.ts && node scripts/check-wizard.mjs",
    "test:wizard:terminal": "node scripts/check-wizard.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run lint:baseline && npm run test:quality && npm run check:dependencies && npm run build && npm test",
    "bootstrap": "npm ci && npm run build",
    "experiment": "vitest run tests/feasibility",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:report": "eslint . --config eslint.analysis.config.mjs --format json --output-file reports/lint.json",
    "test:coverage": "npm run build && vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/tests.json",
    "test:mutation": "stryker run",
    "check:dependencies": "depcruise src --config .dependency-cruiser.cjs",
    "report:dependencies": "depcruise src --config .dependency-cruiser.cjs --output-type json --output-to reports/dependencies.json",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "test:quality": "node --test scripts/check-lint-baseline-tests.mjs scripts/check-mutation-tests.mjs scripts/quality-evidence-tests.mjs",
    "test:mutation:core": "stryker run stryker.core.config.json",
    "lint:baseline:prune": "node scripts/check-lint-baseline.mjs --prune",
    "test:mutation:check": "node scripts/check-mutation.mjs config core lifecycle process",
    "test:mutation:lifecycle": "stryker run stryker.lifecycle.config.json",
    "test:mutation:process": "stryker run stryker.process.config.json"
  },
  "dependencies": {
    "emittery": "2.1.0",
    "hookable": "6.1.2",
    "read-cmd-shim": "7.0.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "node-pty": "1.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
