{
  "name": "arch-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "npm run build && vitest run tests/acceptance",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "bootstrap": "npm ci && npm run build",
    "experiment": "vitest run tests/feasibility"
  },
  "dependencies": {
    "emittery": "2.1.0",
    "hookable": "6.1.2",
    "read-cmd-shim": "7.0.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
