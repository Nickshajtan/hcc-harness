{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "files": [
    "package.json",
    "tsconfig.json",
    "vitest.core-mutation.config.ts",
    "src/**/*.ts",
    "tests/unit/core.test.ts",
    "tests/unit/execution-policy.test.ts",
    "tests/unit/environment.test.ts",
    "tests/unit/events.test.ts",
    "src/core/*.ts"
  ],
  "mutate": ["src/core/**/*.ts", "src/middleware.ts", "src/events.ts"],
  "vitest": {
    "configFile": "vitest.core-mutation.config.ts"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation-core/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-core/index.html"
  },
  "thresholds": {
    "break": 0
  }
}
