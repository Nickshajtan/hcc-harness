{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "files": [
    "package.json",
    "tsconfig.json",
    "vitest.lifecycle-mutation.config.ts",
    "src/**/*.ts",
    "tests/unit/manifest.test.ts",
    "tests/unit/routing-journal.test.ts",
    "tests/unit/ownership.test.ts"
  ],
  "mutate": [
    "src/lifecycle/manifest.ts",
    "src/lifecycle/ownership.ts",
    "src/lifecycle/routing-journal.ts",
    "src/lifecycle/recovery-validation.ts"
  ],
  "vitest": { "configFile": "vitest.lifecycle-mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation-lifecycle/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-lifecycle/index.html" },
  "thresholds": { "break": 0 }
}
