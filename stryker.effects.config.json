{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "files": [
    "package.json",
    "tsconfig.json",
    "vitest.effects-mutation.config.ts",
    "src/**/*.ts",
    "vendor/shim-*.exe",
    ".tools/publication/*",
    "tests/unit/lifecycle-effects.test.ts",
    "tests/unit/lifecycle.test.ts",
    "tests/unit/lifecycle-contract.test.ts",
    "tests/unit/setup-contract.test.ts",
    "tests/unit/native-publication-state.test.ts",
    "tests/unit/publication-resource.test.ts",
    "tests/unit/publication-process.test.ts",
    "tests/integration/native-publication.test.ts",
    "tests/fixtures/publication-holder.cs",
    "tests/unit/uninstall.test.ts"
  ],
  "mutate": [
    "src/installation/setup.ts",
    "src/lifecycle/routing-plan.ts",
    "src/lifecycle/routing-files.ts",
    "src/lifecycle/native-publication.ts",
    "src/lifecycle/recovery.ts",
    "src/lifecycle/removal.ts"
  ],
  "vitest": { "configFile": "vitest.effects-mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation-effects/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-effects/index.html" },
  "thresholds": { "break": 0 }
}
