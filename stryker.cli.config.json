{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "files": [
    "package.json",
    "tsconfig.json",
    "vitest.cli-mutation.config.ts",
    "src/**/*.ts",
    "vendor/**",
    "tests/unit/cli-policy.test.ts",
    "tests/unit/cli-dispatch.test.ts",
    "tests/unit/cli-run.test.ts",
    "tests/unit/wizard.test.ts"
  ],
  "mutate": [
    "src/cli/parsing.ts",
    "src/cli/native-run.ts",
    "src/cli/dispatch.ts",
    "src/cli/presentation.ts",
    "src/wizard/decisions.ts",
    "src/wizard/workflow.ts"
  ],
  "vitest": { "configFile": "vitest.cli-mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation-cli/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-cli/index.html" },
  "thresholds": { "break": 0 }
}
